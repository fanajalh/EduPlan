{
  "expo": {
    "name": "EduPlaner",
    "slug": "eduplaner",
    "scheme": "eduplaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fanajalh.eduplaner",
      "adaptiveIcon": {
        "backgroundColor": "#6284F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark-content"
      },
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "EduPlaner memerlukan izin kalender untuk menyinkronkan jadwal pelajaran dan tugas ke kalender ponsel Anda."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6284F6"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "JadwalWidget",
              "label": "Jadwal EduPlaner",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Jadwal kelas & pelajaran aktif hari ini",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TugasWidget",
              "label": "Tugas EduPlaner",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Daftar tugas & PR yang mendekati deadline",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
